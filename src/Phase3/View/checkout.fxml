<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="Phase3.Controller.CheckoutController"
            stylesheets="@../CSS/style.css"
            style="-fx-background-color:#000000;">

    <!-- Title -->

    <top>

        <VBox alignment="CENTER">

            <padding>
                <Insets top="35" bottom="30"/>
            </padding>

            <Label text="CHECKOUT"
                   style="-fx-text-fill:#d4af37;
                          -fx-font-size:42;
                          -fx-font-weight:bold;"/>

        </VBox>

    </top>

    <!-- Form -->

    <center>

        <VBox alignment="CENTER"
              spacing="20">

            <TextField fx:id="nameField"
                       promptText="Customer Name"
                       maxWidth="350"/>

            <TextField fx:id="phoneField"
                       promptText="Phone Number"
                       maxWidth="350"/>

            <TextField fx:id="addressField"
                       promptText="Delivery Address"
                       maxWidth="350"/>

            <ChoiceBox fx:id="paymentChoice"
                       prefWidth="350"/>

            <Label fx:id="totalLabel"
                   text="Grand Total : 0 JOD"
                   style="-fx-text-fill:#d4af37;
                          -fx-font-size:24;
                          -fx-font-weight:bold;"/>

        </VBox>

    </center>

    <!-- Buttons -->

    <bottom>

        <HBox alignment="CENTER"
              spacing="25">

            <padding>
                <Insets top="30" bottom="30"/>
            </padding>

            <Button text="← Back"
                    prefWidth="180"
                    onAction="#goBack"/>

            <Button text="✔ Place Order"
        onAction="#placeOrder"/>

        </HBox>

    </bottom>

</BorderPane>